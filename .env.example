# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 로 커밋 제외됨)
# GitHub Actions 에서는 Settings > Secrets and variables > Actions 의 Secrets 로 같은 이름을 등록합니다.
# 주의: 이 파일(.env.example)에는 절대 실제 키를 적지 마세요. 공개 저장소에 올라갑니다.

# 네이버 API HUB (데이터랩 쇼핑인사이트)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 인증키 (한국관광공사 API 공용). 포털 '마이페이지 > 인증키'의 Decoding 키 권장
DATA_GO_KR_KEY=
# 관광지별 연관 관광지 API 전용 키가 따로 있을 때만 입력 (비우면 DATA_GO_KR_KEY 사용)
TOUR_RLTE_KEY=

# 옵션: 데이터랩 웹 '분야별 인기검색어' 비공식 수집(A-2). 기본 false
USE_DATALAB_WEB_RANK=false
